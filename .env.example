# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/atlas_erp?schema=public"

# API Configuration
API_PORT=3001
API_URL=http://localhost:3001

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Mailtrap - Development/Sandbox Mode)
# Get your credentials from: https://mailtrap.io/inboxes
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-username
EMAIL_PASS=your-mailtrap-password
EMAIL_FROM=noreply@atlas-erp.com

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Gravatar Integration
# Get credentials from: https://docs.gravatar.com/rest-api/
GRAVATAR_API_KEY=your-gravatar-api-key
GRAVATAR_CLIENT_ID=your-gravatar-client-id
GRAVATAR_CLIENT_SECRET=your-gravatar-client-secret
NEXT_PUBLIC_GRAVATAR_CLIENT_ID=your-gravatar-client-id

# Environment
NODE_ENV=development
