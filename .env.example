# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/atlas_erp?schema=public"

# API Configuration
API_PORT=3001
API_URL=http://localhost:3001

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# BetterAuth
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email Configuration (Brevo Transactional Email) ─────────────────────────
# Sign up at https://brevo.com → API Keys → Create API Key
# Verify your sender email address (Gmail works for dev/low volume).
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=yourname@gmail.com
EMAIL_FROM_NAME=Atlas ERP

# ─── Google OAuth Configuration ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# ─── Trusted Origins (for SSO/CORS in prod, comma-separated) ─────────────────
TRUSTED_ORIGINS=

# Gravatar Integration
GRAVATAR_API_KEY=your-gravatar-api-key
GRAVATAR_CLIENT_ID=your-gravatar-client-id
GRAVATAR_CLIENT_SECRET=your-gravatar-client-secret
NEXT_PUBLIC_GRAVATAR_CLIENT_ID=your-gravatar-client-id

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Environment
NODE_ENV=development
