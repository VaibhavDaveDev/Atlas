# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/atlas_erp?schema=public"

# API Configuration
PORT=3001
API_PREFIX=api/v1

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# BetterAuth Configuration
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Session Management
# Maximum number of concurrent sessions per user (default: 3)
# When exceeded, the oldest session is automatically revoked
MAX_SESSIONS_PER_USER=3

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email Configuration ──────────────────────────────────────────────────────
# Choose your email provider: "brevo" (default) or "gmail"
# Switch between providers without any code changes — just update EMAIL_PROVIDER.
EMAIL_PROVIDER=gmail
EMAIL_FROM_NAME=Atlas ERP

# Option A — Gmail SMTP (no domain required, works out of the box)
# 1. Enable 2FA on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-char App Password below (NOT your normal Gmail password)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B — Brevo Transactional API (recommended when you own a domain)
# Sign up at https://brevo.com → API Keys → Create API Key
# Verify your sender domain at Brevo → Senders & Domains
# Set EMAIL_PROVIDER=brevo and fill in:
# BREVO_API_KEY=your-brevo-api-key
# EMAIL_FROM=noreply@yourdomain.com

# ─── Google OAuth Configuration ───────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Environment
NODE_ENV=development

# ─── Trusted Origins (comma-separated for SSO/CORS in prod) ───────────────────
# Example: TRUSTED_ORIGINS=https://app.yourcompany.com,https://yourcompany.com
TRUSTED_ORIGINS=

# Web App URL (used in magic link callbacks and invite emails)
WEB_URL=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100

# Logging (Grafana Loki Cloud - Production)
# LOKI_ENABLED=true
# LOKI_URL="https://logs-prod-xxx.grafana.net"
# LOKI_USER="your-loki-user-id"
# LOKI_PASSWORD="your-grafana-cloud-api-token"

# ─── Gravatar Integration ─────────────────────────────────────────────────────
# Get credentials from: https://docs.gravatar.com/rest-api/
GRAVATAR_API_KEY=your-gravatar-api-key
GRAVATAR_CLIENT_ID=your-gravatar-client-id
GRAVATAR_CLIENT_SECRET=your-gravatar-client-secret
NEXT_PUBLIC_GRAVATAR_CLIENT_ID=your-gravatar-client-id

# ─── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Get credentials from: https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY is used for server-side verification
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
