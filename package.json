{
  "name": "project-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Cloud ERP Suite",
  "homepage": "https://atlas-erp-docs.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/VaibhavDaveDev/Atlas"
  },
  "bugs": {
    "url": "https://github.com/VaibhavDaveDev/Atlas/issues"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "clean:dist": "rimraf apps/api/dist apps/web/.next apps/web/.worker-next apps/web/out",
    "prebuild": "pnpm run clean:dist",
    "setup": "pnpm --filter @atlas/database run build",
    "dev:api": "pnpm run setup && pnpm --filter @atlas/api run dev",
    "dev:web": "pnpm --filter @atlas/web run dev",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
